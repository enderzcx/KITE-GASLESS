# Production backend env example (single-host, same-domain deployment)
# Copy to backend/.env and fill real values.

PORT=3001
KITEAI_RPC_URL=https://rpc-testnet.gokite.ai/
KITEAI_BUNDLER_URL=https://bundler-service.staging.gokite.ai/rpc/
KITE_ENTRYPOINT_ADDRESS=0x4337084D9E255Ff0702461CF8895CE9E3b5Ff108
KITE_PROOF_RPC_TIMEOUT_MS=10000
KITE_PROOF_RPC_RETRIES=3

# Required: backend signer (testnet key only)
KITECLAW_BACKEND_SIGNER_PRIVATE_KEY=0x_your_test_private_key

# Persistence backend
# file is recommended for single-host demo deployment.
KITE_PERSISTENCE_MODE=file
DATABASE_URL=
KITE_PG_SSL=0
KITE_PG_SSL_REJECT_UNAUTHORIZED=0

# Demo launch can keep API keys empty.
# For stricter production, set these and pass x-api-key or Bearer token.
KITECLAW_API_KEY_ADMIN=
KITECLAW_API_KEY_AGENT=
KITECLAW_API_KEY_VIEWER=
KITECLAW_RATE_LIMIT_WINDOW_MS=60000
KITECLAW_RATE_LIMIT_MAX=240
IDENTITY_VERIFY_MODE=registry_only

# Optional fixed session material (leave empty to use runtime-created session)
KITECLAW_SESSION_KEY=
KITECLAW_SESSION_ADDRESS=
KITECLAW_SESSION_ID=

# OpenClaw remote API (OpenAI-compatible)
OPENCLAW_BASE_URL=https://your-openclaw-or-openai-gateway
OPENCLAW_CHAT_PROTOCOL=openai
OPENCLAW_CHAT_PATH=/v1/chat/completions
OPENCLAW_HEALTH_PATH=/v1/models
OPENCLAW_TIMEOUT_MS=12000
OPENCLAW_MODEL=<your_model_id>
OPENCLAW_API_KEY=
OPENCLAW_SYSTEM_PROMPT=

# x402/action config
KITE_SETTLEMENT_TOKEN=0x0fF5393387ad2f9f691FD6Fd28e07E3969e27e63
KITE_MERCHANT_ADDRESS=0x6D705b93F0Da7DC26e46cB39Decc3baA4fb4dd29
X402_PRICE=0.05
X402_REACTIVE_PRICE=0.03
X402_BTC_PRICE=0.00001
X402_X_READER_PRICE=0.00001
KITE_AGENT2_AA_ADDRESS=0xEd335560178B85f0524FfFf3372e9Bf45aB42aC8
KITE_POLICY_MAX_PER_TX=0.20
KITE_POLICY_DAILY_LIMIT=0.60
KITE_POLICY_ALLOWED_RECIPIENTS=0x6D705b93F0Da7DC26e46cB39Decc3baA4fb4dd29,0xEd335560178B85f0524FfFf3372e9Bf45aB42aC8

# Autonomous ATAPI BTC price polling (server-side)
# Keep enabled=1 for production minute loop.
AUTO_BTC_PRICE_ENABLED=1
AUTO_BTC_PRICE_INTERVAL_MS=60000
AUTO_BTC_PRICE_SOURCE_AGENT_ID=1
AUTO_BTC_PRICE_TARGET_AGENT_ID=2
AUTO_BTC_PRICE_PAIR=BTCUSDT
# primary: hyperliquid, runtime fallback: binance -> okx
AUTO_BTC_PRICE_SOURCE=hyperliquid
AUTO_BTC_PRICE_PAYER=0x_your_aa_wallet

# x-reader digest defaults
X_READER_MAX_CHARS_DEFAULT=1200
X_READER_TIMEOUT_MS=12000

# ERC-8004 identity
ERC8004_IDENTITY_REGISTRY=0x_your_identity_registry
ERC8004_AGENT_ID=0
